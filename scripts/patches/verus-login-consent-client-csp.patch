new file mode 100644
index 0000000..454a8c6
--- /dev/null
+++ b/src/rpc/calls/provisioningTransport.js
@@ -0,0 +1,28 @@
+import {
+  API_GET_ID_PROVISIONING_STATUS,
+  API_SUBMIT_ID_PROVISIONING_REQUEST,
+  NATIVE,
+  POST,
+} from '../../utils/constants';
+import { getApiData } from '../callCreator';
+
+const callProvisioningTransport = async (route, payload) => {
+  const response = await getApiData(NATIVE, route, payload, POST, true);
+  if (response == null || response.msg !== 'success') {
+    throw new Error(
+      response && typeof response.result === 'string'
+        ? response.result
+        : 'The provisioning service request failed.'
+    );
+  }
+  return response.result;
+};
+
+export const submitIdProvisioningRequest = (capability, request) =>
+  callProvisioningTransport(API_SUBMIT_ID_PROVISIONING_REQUEST, {
+    capability,
+    request,
+  });
+
+export const getIdProvisioningStatus = (capability, uri) =>
+  callProvisioningTransport(API_GET_ID_PROVISIONING_STATUS, { capability, uri });
